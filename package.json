{
  "name": "timevault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"pnpm --filter @timevault/server dev\" \"pnpm --filter @timevault/client dev\"",
    "dev:server": "pnpm --filter @timevault/server dev",
    "dev:client": "pnpm --filter @timevault/client dev",
    "build": "pnpm --filter @timevault/client build && pnpm --filter @timevault/server build",
    "build:site": "VITE_STANDALONE=true pnpm --filter @timevault/client build",
    "build:github": "VITE_STANDALONE=true VITE_GITHUB_PAGES=true VITE_BASE_PATH=/timevault/ pnpm --filter @timevault/client build && node scripts/finalize-github-pages.mjs",
    "start": "pnpm --filter @timevault/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0"
}
